# ============================================================
# SuperBizAgent 环境变量模板
# 用法：复制本文件为 .env，填入你自己的密钥后启动服务
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ---------- 应用 ----------
APP_NAME=SuperBizAgent
DEBUG=false
HOST=0.0.0.0
PORT=9900

# ---------- 阿里云 DashScope（必填）----------
# API Key 获取：https://bailian.console.aliyun.com/ → 右上角 API-KEY 管理
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# ---------- Milvus 向量库 ----------
# 用 vector-database.yml 启动：docker compose -f vector-database.yml up -d
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# ---------- RAG 与文档分块 ----------
RAG_TOP_K=3
RAG_MODEL=qwen-max
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ---------- MCP 服务 ----------
# 需先启动：python mcp_servers/cls_server.py（8003）与 monitor_server.py（8004）
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
